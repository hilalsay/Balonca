# Example environment for the API (copy to /etc/balonca.env, chmod 600). Values here are placeholders.
PORT=8787
HOST=127.0.0.1
TRUST_PROXY=1
PUBLIC_ORIGIN=https://balonca.example.com
RATE_PER_MINUTE=30
# Local model (Ollama) — keep it on localhost only
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:latest
# Reading mode: grammar and speech (Python venv next to server/)
TTS_ENABLED=1
TTS_NEW_PER_10MIN=60
TTS_CHARS_PER_DAY=30000
TTS_CACHED_PER_MIN=120
PARSE_PER_MINUTE=60
# Accounts (off unless AUTH=on). Sign in with Google: an OAuth client of type "Web application" whose
# authorized redirect URI is <PUBLIC_ORIGIN>/api/auth/google/callback. New people still need an invite link.
AUTH=on
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
